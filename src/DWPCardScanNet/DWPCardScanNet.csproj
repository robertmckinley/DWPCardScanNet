<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinForms executable, .NET Framework 4.8, x86.
    x86 is mandatory for the target: the biometric pipeline will interop with the
    32-bit Aware AccuScan COM controls in a later increment. (LEADTOOLS is NOT
    referenced - this port uses GDI+/System.Drawing instead.)
    For now this is a foundation shell that only loads and displays the configuration.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DWPCardScanNet</RootNamespace>
    <AssemblyName>DWPCardScanNet</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <!-- Shown in the main window title bar (MainForm reads GetName().Version). -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DWPCardScanNet.Core\DWPCardScanNet.Core.csproj" />
    <ProjectReference Include="..\DWPCardScanNet.Aware\DWPCardScanNet.Aware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT-licensed, no cost. GDI+ build (System.Drawing) for net48. -->
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
  </ItemGroup>

  <ItemGroup>
    <!-- A sample/template .ini shipped alongside the exe. It is NOT loaded at runtime -
         the app requires the real DWPCardScan.ini in the application folder. Deploying it as
         *_Sample* keeps a fresh install from silently running on a placeholder config. -->
    <None Update="DWPCardScan_Sample.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
